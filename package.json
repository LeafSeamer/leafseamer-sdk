{
  "name": "@leafseamer/sdk",
  "version": "0.1.0-dev.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "LeafSeamer 类型客户端、严格报文校验与定向 HTTP 传输",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "packageManager": "npm@11.19.1",
  "exports": {
    "./capability-template": {
      "types": "./dist/capability-template.d.mts",
      "import": "./dist/capability-template.mjs"
    },
    "./release-manifest": {
      "types": "./dist/release-manifest.d.mts",
      "import": "./dist/release-manifest.mjs"
    },
    "./artifact-import": {
      "types": "./dist/artifact-import.d.mts",
      "import": "./dist/artifact-import.mjs"
    },
    "./bootstrap": {
      "types": "./dist/bootstrap.d.mts",
      "import": "./dist/bootstrap.mjs"
    },
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./http": {
      "types": "./dist/http.d.mts",
      "import": "./dist/http.mjs"
    },
    "./supervisor-control": {
      "types": "./dist/supervisor-control.d.mts",
      "import": "./dist/supervisor-control.mjs"
    },
    "./worker-runtime": {
      "types": "./dist/worker-runtime.d.mts",
      "import": "./dist/worker-runtime.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CONTRACT.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --disallow-code-generation-from-strings --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "5.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
