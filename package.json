{
  "name": "@leafseamer/sdk",
  "version": "0.1.0-dev.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "LeafSeamer 类型客户端、严格报文校验与定向 HTTP 传输",
  "engines": { "node": ">=24.22.0 <25" },
  "packageManager": "npm@11.19.1",
  "exports": {
    ".": { "types": "./dist/index.d.mts", "import": "./dist/index.mjs" },
    "./http": { "types": "./dist/http.d.mts", "import": "./dist/http.mjs" }
  },
  "files": ["dist", "LICENSE", "README.md"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --disallow-code-generation-from-strings --test test/*.test.mjs",
    "prepack": "npm run build"
  }
}
