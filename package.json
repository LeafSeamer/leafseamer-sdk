{
  "name": "@leafseamer/sdk",
  "version": "0.1.0-dev.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "LeafSeamer \u7c7b\u578b\u5ba2\u6237\u7aef\u3001\u4e25\u683c\u62a5\u6587\u6821\u9a8c\u4e0e\u5b9a\u5411 HTTP \u4f20\u8f93",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "packageManager": "npm@11.19.1",
  "exports": {
    "./bootstrap": {
      "types": "./dist/bootstrap.d.mts",
      "import": "./dist/bootstrap.mjs"
    },
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./http": {
      "types": "./dist/http.d.mts",
      "import": "./dist/http.mjs"
    },
    "./supervisor-control": {
      "types": "./dist/supervisor-control.d.mts",
      "import": "./dist/supervisor-control.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CONTRACT.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --disallow-code-generation-from-strings --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "5.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
