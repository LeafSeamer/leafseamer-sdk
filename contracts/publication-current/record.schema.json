{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leafseamer.invalid/sdk/publication-current/0.2/record.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "const": "publication-current/0.2.0-draft.1"
    },
    "selection": {
      "const": {
        "contract_id": "leafseamer.api.v1.panel4",
        "contract_digest": "sha256:decbdf83f91486da0f473d0cbd5ad20efd188cc681de3b04a39921a4e72fa4fd"
      }
    },
    "published": {
      "$ref": "#/$defs/lifecycle__PublishedVersion"
    },
    "source": {
      "$ref": "#/$defs/lifecycle__DraftRecord"
    },
    "metadata_digest": {
      "$ref": "#/$defs/lifecycle__Digest"
    },
    "record_digest": {
      "$ref": "#/$defs/lifecycle__Digest"
    }
  },
  "required": [
    "format",
    "selection",
    "published",
    "source",
    "metadata_digest",
    "record_digest"
  ],
  "additionalProperties": false,
  "$defs": {
    "lifecycle__DraftRecord": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/lifecycle__Scope"
        },
        "definition_id": {
          "$ref": "#/$defs/lifecycle__Id"
        },
        "revision": {
          "$ref": "#/$defs/lifecycle__Revision"
        },
        "content": {
          "$ref": "#/$defs/lifecycle__DraftContent"
        },
        "content_digest": {
          "$ref": "#/$defs/lifecycle__Digest"
        },
        "selection_digest": {
          "$ref": "#/$defs/lifecycle__Digest"
        },
        "metadata_revision": {
          "$ref": "#/$defs/lifecycle__Revision"
        },
        "metadata": {
          "$ref": "#/$defs/lifecycle__DefinitionMetadata"
        }
      },
      "required": [
        "scope",
        "definition_id",
        "revision",
        "content",
        "content_digest",
        "selection_digest",
        "metadata_revision",
        "metadata"
      ],
      "additionalProperties": false
    },
    "lifecycle__Scope": {
      "type": "object",
      "properties": {
        "authority_service_id": {
          "$ref": "#/$defs/lifecycle__Id"
        },
        "database_instance_id": {
          "$ref": "#/$defs/lifecycle__Id"
        }
      },
      "required": [
        "authority_service_id",
        "database_instance_id"
      ],
      "additionalProperties": false
    },
    "lifecycle__Id": {
      "$ref": "#/$defs/lifecycle__Program_Id"
    },
    "lifecycle__Program_Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])"
    },
    "lifecycle__Revision": {
      "$ref": "#/$defs/lifecycle__Program_Revision"
    },
    "lifecycle__Program_Revision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$(?![\\s\\S])"
    },
    "lifecycle__DraftContent": {
      "type": "object",
      "properties": {
        "program": {
          "$ref": "#/$defs/lifecycle__Program_Program"
        },
        "selections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lifecycle__BindingSelection"
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "policy_ref": {
          "$ref": "#/$defs/lifecycle__PolicyRef"
        }
      },
      "required": [
        "program",
        "selections",
        "policy_ref"
      ],
      "additionalProperties": false
    },
    "lifecycle__Program_Program": {
      "oneOf": [
        {
          "$ref": "#/$defs/lifecycle__Program_Rule"
        },
        {
          "$ref": "#/$defs/lifecycle__Program_StateMachine"
        }
      ]
    },
    "lifecycle__Program_Rule": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "rule"
        },
        "trigger_binding_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])"
        },
        "condition": {
          "$ref": "#/$defs/lifecycle__Program_Condition"
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lifecycle__Program_Group"
          },
          "maxItems": 64,
          "minItems": 1,
          "uniqueItems": false
        }
      },
      "required": [
        "kind",
        "trigger_binding_id",
        "condition",
        "groups"
      ],
      "additionalProperties": false
    },
    "lifecycle__Program_Condition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "literal"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "compare"
            },
            "operator": {
              "enum": [
                "eq",
                "ne",
                "lt",
                "lte",
                "gt",
                "gte"
              ]
            },
            "value_type": {
              "$ref": "#/$defs/lifecycle__Program_TypeSpec"
            },
            "left": {
              "$ref": "#/$defs/lifecycle__Program_Value"
            },
            "right": {
              "$ref": "#/$defs/lifecycle__Program_Value"
            }
          },
          "required": [
            "kind",
            "operator",
            "value_type",
            "left",
            "right"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "all",
                "any"
              ]
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/lifecycle__Program_Condition"
              },
              "maxItems": 256,
              "minItems": 1,
              "uniqueItems": false
            }
          },
          "required": [
            "kind",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "not"
            },
            "item": {
              "$ref": "#/$defs/lifecycle__Program_Condition"
            }
          },
          "required": [
            "kind",
            "item"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "exists",
                "is_null"
              ]
            },
            "value": {
              "$ref": "#/$defs/lifecycle__Program_Reference"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "lifecycle__Program_TypeSpec": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "boolean",
            "null",
            "string",
            "binary64",
            "integer_string",
            "json"
          ]
        },
        "unit": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "unit"
      ],
      "additionalProperties": false
    },
    "lifecycle__Program_Value": {
      "oneOf": [
        {
          "$ref": "#/$defs/lifecycle__Program_Literal"
        },
        {
          "$ref": "#/$defs/lifecycle__Program_Reference"
        }
      ]
    },
    "lifecycle__Program_Literal": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "literal"
        },
        "value": {}
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    "lifecycle__Program_Reference": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "ref"
        },
        "source": {
          "enum": [
            "event",
            "observation",
            "machine",
            "step_result"
          ]
        },
        "binding_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])"
        },
        "pointer": {
          "type": "string",
          "maxLength": 1024,
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$(?![\\s\\S])"
        }
      },
      "required": [
        "kind",
        "source",
        "binding_id",
        "pointer"
      ],
      "additionalProperties": false
    },
    "lifecycle__Program_Group": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "sequence",
            "parallel"
          ]
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lifecycle__Program_Step"
          },
          "maxItems": 64,
          "minItems": 1,
          "uniqueItems": false
        }
      },
      "required": [
        "mode",
        "steps"
      ],
      "additionalProperties": false
    },
    "lifecycle__Program_Step": {
      "oneOf": [
        {
          "$ref": "#/$defs/lifecycle__Program_ActionStep"
        },
        {
          "$ref": "#/$defs/lifecycle__Program_DelayStep"
        }
      ]
    },
    "lifecycle__Program_ActionStep": {
      "type": "object",
      "properties": {
        "step_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])"
          },
          "maxItems": 4096,
          "minItems": 0,
          "uniqueItems": true
        },
        "required": {
          "type": "boolean"
        },
        "failure_policy": {
          "enum": [
            "stop",
            "continue_if_independent"
          ]
        },
        "kind": {
          "const": "action"
        },
        "action_binding_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])"
        },
        "parameters": {
          "type": "object"
        },
        "parameter_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lifecycle__Program_ParameterBinding"
          },
          "maxItems": 256,
          "minItems": 0,
          "uniqueItems": false
        },
        "guard": {
          "$ref": "#/$defs/lifecycle__Program_Condition"
        }
      },
      "required": [
        "step_id",
        "depends_on",
        "required",
        "failure_policy",
        "kind",
        "action_binding_id",
        "parameters",
        "parameter_bindings",
        "guard"
      ],
      "additionalProperties": false
    },
    "lifecycle__Program_ParameterBinding": {
      "type": "object",
      "properties": {
        "target_pointer": {
          "type": "string",
          "maxLength": 1024,
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$(?![\\s\\S])"
        },
        "value": {
          "$ref": "#/$defs/lifecycle__Program_Value"
        }
      },
      "required": [
        "target_pointer",
        "value"
      ],
      "additionalProperties": false
    },
    "lifecycle__Program_DelayStep": {
      "type": "object",
      "properties": {
        "step_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])"
          },
          "maxItems": 4096,
          "minItems": 0,
          "uniqueItems": true
        },
        "required": {
          "const": true
        },
        "failure_policy": {
          "const": "stop"
        },
        "kind": {
          "const": "delay"
        },
        "delay_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "max_lateness_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        }
      },
      "required": [
        "step_id",
        "depends_on",
        "required",
        "failure_policy",
        "kind",
        "delay_ms",
        "max_lateness_ms"
      ],
      "additionalProperties": false
    },
    "lifecycle__Program_StateMachine": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "state_machine"
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])"
          },
          "maxItems": 256,
          "minItems": 1,
          "uniqueItems": true
        },
        "initial_state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])"
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lifecycle__Program_Transition"
          },
          "maxItems": 256,
          "minItems": 1,
          "uniqueItems": false
        }
      },
      "required": [
        "kind",
        "states",
        "initial_state",
        "transitions"
      ],
      "additionalProperties": false
    },
    "lifecycle__Program_Transition": {
      "type": "object",
      "properties": {
        "transition_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])"
        },
        "from_state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])"
        },
        "to_state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])"
        },
        "priority": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "trigger_binding_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])"
        },
        "condition": {
          "$ref": "#/$defs/lifecycle__Program_Condition"
        },
        "exit": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lifecycle__Program_Step"
          },
          "maxItems": 64,
          "minItems": 0,
          "uniqueItems": false
        },
        "transition": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lifecycle__Program_Step"
          },
          "maxItems": 64,
          "minItems": 0,
          "uniqueItems": false
        },
        "enter": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lifecycle__Program_Step"
          },
          "maxItems": 64,
          "minItems": 0,
          "uniqueItems": false
        }
      },
      "required": [
        "transition_id",
        "from_state",
        "to_state",
        "priority",
        "trigger_binding_id",
        "condition",
        "exit",
        "transition",
        "enter"
      ],
      "additionalProperties": false
    },
    "lifecycle__BindingSelection": {
      "type": "object",
      "properties": {
        "binding_id": {
          "$ref": "#/$defs/lifecycle__Id"
        },
        "kind": {
          "enum": [
            "input",
            "action"
          ]
        },
        "content_ref": {
          "$ref": "#/$defs/lifecycle__Program_ContentRef"
        }
      },
      "required": [
        "binding_id",
        "kind",
        "content_ref"
      ],
      "additionalProperties": false
    },
    "lifecycle__Program_ContentRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])"
        },
        "revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$(?![\\s\\S])"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
        }
      },
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "additionalProperties": false
    },
    "lifecycle__PolicyRef": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "policy"
        },
        "scope": {
          "$ref": "#/$defs/lifecycle__Scope"
        },
        "object_id": {
          "$ref": "#/$defs/lifecycle__Id"
        },
        "revision": {
          "$ref": "#/$defs/lifecycle__Revision"
        },
        "digest": {
          "$ref": "#/$defs/lifecycle__Digest"
        }
      },
      "required": [
        "kind",
        "scope",
        "object_id",
        "revision",
        "digest"
      ],
      "additionalProperties": false
    },
    "lifecycle__Digest": {
      "$ref": "#/$defs/lifecycle__Program_Digest"
    },
    "lifecycle__Program_Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
    },
    "lifecycle__DefinitionMetadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        },
        "layout": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "description",
        "layout"
      ],
      "additionalProperties": false
    },
    "lifecycle__PublishedVersion": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/lifecycle__Scope"
        },
        "definition_id": {
          "$ref": "#/$defs/lifecycle__Id"
        },
        "definition_version": {
          "$ref": "#/$defs/lifecycle__Revision"
        },
        "source_draft_revision": {
          "$ref": "#/$defs/lifecycle__Revision"
        },
        "artifact_ref": {
          "$ref": "#/$defs/lifecycle__ArtifactRef"
        },
        "program_digest": {
          "$ref": "#/$defs/lifecycle__Digest"
        },
        "bindings_digest": {
          "$ref": "#/$defs/lifecycle__Digest"
        },
        "published_by": {
          "$ref": "#/$defs/lifecycle__Id"
        }
      },
      "required": [
        "scope",
        "definition_id",
        "definition_version",
        "source_draft_revision",
        "artifact_ref",
        "program_digest",
        "bindings_digest",
        "published_by"
      ],
      "additionalProperties": false
    },
    "lifecycle__ArtifactRef": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "artifact"
        },
        "scope": {
          "$ref": "#/$defs/lifecycle__Scope"
        },
        "object_id": {
          "$ref": "#/$defs/lifecycle__Id"
        },
        "revision": {
          "$ref": "#/$defs/lifecycle__Revision"
        },
        "digest": {
          "$ref": "#/$defs/lifecycle__Digest"
        }
      },
      "required": [
        "kind",
        "scope",
        "object_id",
        "revision",
        "digest"
      ],
      "additionalProperties": false
    }
  }
}
